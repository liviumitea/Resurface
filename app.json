{
  "expo": {
    "name": "Resurface",
    "slug": "resurface",
    "scheme": "resurface",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.resurface.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of things you want to remember.",
        "NSPhotoLibraryUsageDescription": "Choose photos of things you want to remember.",
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "app.resurface.mobile.backup",
            "UTTypeDescription": "Resurface Backup",
            "UTTypeConformsTo": [
              "public.data",
              "public.content"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "resurfacebackup"
              ],
              "public.mime-type": [
                "application/x-resurface-backup"
              ]
            }
          }
        ],
        "CFBundleLocalizations": [
          "en",
          "ro"
        ],
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "android": {
      "package": "app.resurface.mobile",
      "allowBackup": false,
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos of things you want to remember.",
          "cameraPermission": "Take photos of things you want to remember."
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "locales": {
      "en": "./locales/en.json",
      "ro": "./locales/ro.json"
    }
  }
}
